{
  "name": "clad",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "mcp:setup": "node scripts/setup-mcp.js",
    "install-cli": "pnpm --dir packages/cli link --global",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @clad/plaid-adapter test:integration",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write packages"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "hono@<4.12.25": ">=4.12.25",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "qs@<6.15.2": ">=6.15.2"
    }
  },
  "devDependencies": {
    "pnpm": "^10.34.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}

{
  "name": "clad",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "mcp:setup": "node scripts/setup-mcp.js",
    "install-cli": "pnpm --dir packages/cli link --global",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write packages"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "pnpm": "^10.33.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

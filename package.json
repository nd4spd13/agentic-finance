{
  "name": "clad",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "mcp:setup": "node scripts/setup-mcp.js",
    "install-cli": "pnpm --dir packages/cli link --global",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @clad/plaid-adapter test:integration",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write packages",
    "pretest": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller"
    ],
    "overrides": {
      "hono@<4.12.34": ">=4.12.34",
      "@hono/node-server@<1.20.6": ">=1.20.6",
      "@hono/node-server@>=2.0.0 <2.0.10": ">=2.0.10",
      "body-parser@<2.3.0": ">=2.3.0",
      "fast-uri@<4.1.2": ">=4.1.2",
      "ip-address@<10.3.1": ">=10.3.1",
      "qs@<6.15.2": ">=6.15.2",
      "nanoid@<5.1.16": ">=5.1.16",
      "undici@<7.29.0": ">=7.29.0"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "pnpm": "^12.15.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

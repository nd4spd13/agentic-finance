{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Clad UI (static preview)",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["packages/cli/static/serve-preview.mjs"],
      "port": 3456
    },
    {
      "name": "Docs Site (Vitepress)",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["packages/docs/node_modules/vitepress/bin/vitepress.js", "dev", "packages/docs", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "CLI - Build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "pnpm", "--", "build"],
      "cwd": "packages/cli"
    },
    {
      "name": "Core - Build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "pnpm", "--", "build"],
      "cwd": "packages/core"
    },
    {
      "name": "MCP Server - Build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "pnpm", "--", "build"],
      "cwd": "packages/mcp-server"
    },
    {
      "name": "All - Tests",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "pnpm", "--", "test"],
      "cwd": "."
    }
  ]
}

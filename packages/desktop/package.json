{
  "name": "@clad/desktop",
  "productName": "Clad",
  "version": "0.7.1",
  "private": true,
  "description": "Clad desktop app (Electron) — MCP server lifecycle, approvals, audit, dashboard.",
  "author": "Christopher Brown",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nd4spd13/agentic-finance.git",
    "directory": "packages/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:dir": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clad/core": "workspace:*",
    "@clad/plaid-adapter": "workspace:*",
    "@clad/simplefin-adapter": "workspace:*",
    "@clad/mcp-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "mcp-remote": "0.1.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
